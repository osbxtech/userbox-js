{
  "name": "@userbox/node",
  "version": "1.0.0-alpha.2",
  "description": "Official TypeScript SDK for the Userbox identity and authorization platform.",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md",
    "SECURITY.md"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:types": "tsd",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.test.json",
    "clean": "rm -rf dist",
    "lint": "eslint ."
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@typescript-eslint/parser": "^8.20.0",
    "eslint": "^10.14.0",
    "jose": "^6.2.15",
    "tsd": "^0.33.0",
    "tsup": "^9.0.0",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  },
  "tsd": {
    "directory": "tests"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/osbxtech/userbox-js.git",
    "directory": "node"
  },
  "homepage": "https://docs.test.userbox.app",
  "bugs": {
    "url": "https://github.com/osbxtech/userbox-js/issues"
  },
  "author": "OsbxTech <opensource@osbxtech.nl>",
  "license": "Apache-2.0"
}
